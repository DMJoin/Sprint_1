time = '1h 45m,360s,25m,30m 120s,2h 60s'
time_parts = time.split(',')
counter_minutes = 0

for time_value in time_parts:
    parts = time_value.split()
    for part in parts:
        if 'h' in part:
            counter_minutes += int(part.replace('h', '')) * 60
        elif 'm' in part:
            counter_minutes += int(part.replace('m', ''))
        elif 's' in part:
            counter_minutes += int(part.replace('s', '')) // 60

print(counter_minutes)